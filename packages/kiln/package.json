{
  "name": "@electro1207/kiln",
  "version": "0.5.0",
  "description": "200+ animated React components for Tailwind CSS v4 and Motion, in light and dark. Use the npm package or copy any one in with the shadcn CLI.",
  "keywords": ["react", "react-19", "react-components", "component-library", "ui", "ui-components", "animated-components", "animation", "motion", "framer-motion", "tailwindcss", "tailwind-v4", "shadcn", "shadcn-ui", "shadcn-registry", "design-system", "dark-mode", "typescript", "accessible"],
  "license": "MIT",
  "type": "module",
  "homepage": "https://usekiln.pages.dev",
  "bugs": "https://github.com/Electro1207/Kiln/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Electro1207/Kiln.git",
    "directory": "src/kiln"
  },
  "sideEffects": ["*.css"],
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": { "types": "./lib/index.d.ts", "import": "./lib/index.js" },
    "./styles.css": "./styles.css",
    "./tokens.css": "./tokens.css",
    "./CLAUDE.md": "./CLAUDE.md",
    "./package.json": "./package.json",
    "./*": { "types": "./lib/groups/*.d.ts", "import": "./lib/groups/*.js" }
  },
  "bin": { "kiln-css": "./bin/kiln-css.mjs" },
  "files": ["lib", "bin", "styles.css", "tokens.css", "CLAUDE.md", "README.md", "CHANGELOG.md", "LICENSE"],
  "peerDependencies": {
    "lucide-react": "^1.72.0",
    "motion": "^14.12.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
